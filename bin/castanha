#!/usr/bin/env python3
"""CLI do Castanha: Gravador e assistente de reuniões para Omarchy/Linux."""

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

# Adiciona o diretório do pacote ao sys.path para execução direta
project_root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(project_root))

from castanha.config import get_config_file, load_config, save_config
from castanha.engine import CastanhaEngine
from castanha.i18n import t
from castanha.state import StateManager
from castanha.storage import MeetingStorage

def _evento_da_agenda(uid):
    """O evento pelo uid, na agenda que o daemon já deixou no estado."""
    if not uid:
        return None
    estado = StateManager().read()
    candidatos = list(estado.get("upcoming_meetings") or [])
    if estado.get("next_meeting"):
        candidatos.append(estado["next_meeting"])
    for m in candidatos:
        if isinstance(m, dict) and str(m.get("uid") or "") == str(uid):
            return m
    return None


def cmd_start(args):
    engine = CastanhaEngine()
    mode = "mic_only" if args.mic_only else (args.mode or "dual")
    meeting_slug = getattr(args, "meeting", None)
    evento = _evento_da_agenda(getattr(args, "event", None))
    if getattr(args, "event", None) and evento is None:
        print(t("cli.start.event_not_in_agenda", event=args.event), file=sys.stderr)
    res = engine.start_recording(mode=mode, title=args.title, meeting_event=evento, meeting_slug=meeting_slug)
    if res.get("status") == "recording":
        print(t("cli.start.success", pid=res.get("pid")))
        print(t("cli.start.title", title=res.get("title")))
        print(t("cli.start.mode", mode=mode))
        if meeting_slug:
            print(t("cli.start.linked", slug=meeting_slug))
        if res.get("mic_muted"):
            print(t("cli.start.mic_muted"))
    else:
        print(t("cli.erro", message=res.get("message")))
        sys.exit(1)

def cmd_stop(args):
    engine = CastanhaEngine()
    print(t("cli.stop.processing"))
    res = engine.stop_recording()
    if res.get("status") not in ("success", "partial"):
        print(t("cli.erro", message=res.get("message")))
        sys.exit(1)

    result = res.get("result", {})
    problemas = result.get("problemas") or []

    if not problemas:
        print(t("cli.stop.success"))
    else:
        print(t("cli.stop.with_problems"))
        for p in problemas:
            print(f"   · {p}")

    print(t("cli.stop.bronze", dir=result.get("bronze_dir")))
    print(t("cli.stop.silver", file=result.get("silver_file")))
    print(t("cli.stop.gold", file=result.get("gold_file")))

    # Código de saída honesto: quem chamar isto de script precisa saber.
    if problemas:
        sys.exit(2)

def cmd_pause(args):
    engine = CastanhaEngine()
    res = engine.pause_recording()
    if res.get("status") == "paused":
        print(t("cli.pause.done"))
    else:
        print(t("cli.erro", message=res.get("message")))

def cmd_resume(args):
    engine = CastanhaEngine()
    res = engine.resume_recording()
    if res.get("status") == "recording":
        print(t("cli.resume.done"))
    else:
        print(t("cli.erro", message=res.get("message")))

def cmd_toggle(args):
    engine = CastanhaEngine()
    state = engine.get_status()
    if state.get("status") in ["recording", "paused"]:
        cmd_stop(args)
    else:
        cmd_start(args)

def cmd_status(args):
    state_mgr = StateManager()
    state = MeetingStorage().status_projection(state_mgr.read())
    if args.json:
        print(json.dumps(state, indent=2, ensure_ascii=False))
        return

    status = state.get("status", "idle")
    icons = {"idle": t("cli.status.idle"), "recording": t("cli.status.recording"),
             "paused": t("cli.status.paused"), "processing": t("cli.status.processing")}
    print(t("cli.status.label", status=icons.get(status, status)))
    if status in ["recording", "paused"]:
        elapsed = state.get("elapsed_seconds", 0)
        mins, secs = divmod(elapsed, 60)
        hours, mins = divmod(mins, 60)
        timer = f"{hours:02d}:{mins:02d}:{secs:02d}" if hours else f"{mins:02d}:{secs:02d}"
        print(t("cli.status.elapsed", timer=timer))
        print(t("cli.status.mode", mode=state.get("mode")))
        if state.get("current_meeting"):
            print(t("cli.status.meeting", title=state["current_meeting"].get("title")))
    
    if state.get("next_meeting"):
        next_m = state["next_meeting"]
        print(t("cli.status.next_meeting", title=next_m.get("title"), start=next_m.get("start")))

def cmd_daemon(args):
    from castanha.daemon import run_daemon, running_daemon_pid

    if args.stop:
        import signal as _sig
        pid = running_daemon_pid()
        if pid is None:
            print(t("cli.daemon.not_running"))
            return
        os.kill(pid, _sig.SIGTERM)
        print(t("cli.daemon.stopped", pid=pid))
        return

    if args.status:
        pid = running_daemon_pid()
        print(t("cli.daemon.running", pid=pid) if pid else t("cli.daemon.not_running"))
        return

    ja = running_daemon_pid()
    if ja is not None:
        print(t("cli.daemon.already_running", pid=ja))
        return

    if args.background:
        subprocess.Popen([sys.executable, "-m", "castanha.daemon"], cwd=str(project_root), start_new_session=True)
        print(t("cli.daemon.background_started"))
    else:
        print(t("cli.daemon.foreground"))
        run_daemon()

def cmd_config(args):
    if args.action == "show":
        print(json.dumps(load_config(), indent=2, ensure_ascii=False))
    elif args.action == "path":
        print(get_config_file())

def cmd_notes(args):
    storage = MeetingStorage()
    slug = getattr(args, "slug", None)
    if slug:
        meeting = storage.get_meeting(slug)
        if not meeting:
            print(t("cli.notes.not_found", slug=slug))
            sys.exit(1)
        if getattr(args, "json", False):
            print(json.dumps(meeting, indent=2, ensure_ascii=False))
            return
        print(f"📌 {meeting['title']}")
        print(t("cli.notes.meta", when=meeting["when"], duration=meeting["duration_seconds"], mode=meeting["mode"]))
        print(t("cli.notes.audio_status", status=meeting["audio_status"]))
        if meeting.get("attendees"):
            print(t("cli.notes.attendees"))
            for a in meeting["attendees"]:
                nome = a.get("name") or a.get("email") or t("cli.notes.no_name")
                email = f" <{a['email']}>" if a.get("email") and a.get("name") else ""
                print(f"     · {nome}{email}")
        if meeting.get("recordings"):
            print(t("cli.notes.recordings"))
            for r in meeting["recordings"]:
                print(f"     · {r['filename']} ({r['size_human']}) -> {r['path']}")
        else:
            print(t("cli.notes.recordings_none"))
        if meeting.get("summary_preview"):
            print(t("cli.notes.summary", preview=meeting["summary_preview"]))
        print(t("cli.notes.silver_path", path=meeting["silver_path"]))
        if meeting.get("has_transcript"):
            print(t("cli.notes.transcript", path=meeting["transcript_path"]))
        if meeting.get("gold_path"):
            print(t("cli.notes.gold_path", path=meeting["gold_path"]))
        return

    notes = storage.list_recent_meetings(limit=args.limit)

    if args.json:
        # É por aqui que o painel do Omarchy lista as últimas reuniões.
        print(json.dumps({"notes": notes, "silver_dir": str(storage.silver_dir)},
                         ensure_ascii=False))
        return

    if not notes:
        print(t("cli.notes.none_yet"))
        return
    print(t("cli.notes.recent"))
    for idx, n in enumerate(notes, 1):
        recs = t("cli.notes.recordings_count", count=n.get("recordings_count", 0)) if n.get("recordings_count") else ""
        print(f" {idx}. {n['title']} ({n['when']}){recs} -> {n['silver_path']}")
    if args.open:
        subprocess.Popen(["xdg-open", str(storage.silver_dir)])


def cmd_delete_recording(args):
    engine = CastanhaEngine()
    slug = args.slug
    if slug in ("last", "latest"):
        recentes = engine.storage.list_recent_meetings(limit=1)
        if not recentes:
            print(t("cli.none_found"))
            sys.exit(1)
        slug = recentes[0]["slug"]

    res = engine.delete_recording(slug, getattr(args, "arquivo", None))
    if getattr(args, "json", False):
        print(json.dumps(res, ensure_ascii=False))
        if res.get("status") != "ok":
            sys.exit(1)
        return

    if res.get("status") == "ok":
        print(t("cli.delete.success", file=res.get("deleted_file"), slug=slug))
        rem = res.get("remaining_count", 0)
        if rem > 0:
            print(t("cli.delete.remaining", count=rem))
        else:
            print(t("cli.delete.preserved"))
    else:
        print(t("cli.erro", message=res.get("message")))
        sys.exit(1)


def cmd_recordings_list(args):
    storage = MeetingStorage()
    recs = storage.list_meeting_recordings(args.slug)
    if getattr(args, "json", False):
        print(json.dumps({"recordings": recs}, ensure_ascii=False))
        return
    if not recs:
        print(t("cli.recordings.none", slug=args.slug))
        return
    print(t("cli.recordings.list", slug=args.slug))
    for idx, r in enumerate(recs, 1):
        print(f" {idx}. {r['filename']} ({r['size_human']}) -> {r['path']}")



def cmd_sync(args):
    from castanha.sync import sync_meeting, sync_pending

    if args.all:
        resultados = sync_pending(limit=args.limit)
        if not resultados:
            print(t("cli.sync.no_pending"))
            return
    elif args.slug:
        resultados = [sync_meeting(args.slug)]
    else:
        recentes = MeetingStorage().list_recent_meetings(limit=1)
        if not recentes:
            print(t("cli.sync.no_meetings"))
            return
        resultados = [sync_meeting(recentes[0]["slug"])]

    if args.json:
        print(json.dumps({"results": resultados}, ensure_ascii=False))
        return

    falhou = False
    for r in resultados:
        if r.get("status") == "ok":
            fatos = r.get("facts_ingested", 0)
            print(t("cli.sync.ok", slug=r["slug"]) + (t("cli.sync.facts", count=fatos) if fatos else ""))
        elif r.get("status") == "pending":
            falhou = True
            print(t("cli.sync.pending", slug=r["slug"],
                    reason=r.get("reason") or t("cli.sync.pending_default_reason")))
        elif r.get("status") == "tombstoned":
            print(t("cli.sync.tombstoned", slug=r["slug"]))
        elif r.get("status") == "skipped":
            print(t("cli.sync.skipped", slug=r["slug"], reason=r.get("reason")))
        else:
            falhou = True
            print(t("cli.sync.error", slug=r["slug"]))
            for e in r.get("errors", []):
                print(f"     {e}")
    if falhou:
        sys.exit(2)


def cmd_retry(args):
    """Tenta reenviar áudio para transcrição e rodar toda a esteira (Silver, Gold, Zinom)."""
    engine = CastanhaEngine()
    storage = engine.storage
    em_json = getattr(args, "json", False)

    def sair(mensagem, codigo, resultados=None):
        if em_json:
            print(json.dumps({"results": resultados or [], "message": mensagem}, ensure_ascii=False))
        elif codigo == 0:
            print(mensagem)
        else:
            print(mensagem, file=sys.stderr)
        sys.exit(codigo)

    recentes = storage.list_recent_meetings(limit=args.limit)
    pendentes = [m["slug"] for m in recentes if m.get("can_retry")]

    if args.all:
        slugs = pendentes
    elif args.slug in ("last", "latest"):
        if not recentes:
            sair(t("cli.none_found"), 1)
        slugs = [recentes[0]["slug"]]
    elif args.slug:
        slugs = [args.slug]
    else:
        # Sem argumento é "a última pendente". Nunca a última reunião boa: isso
        # gastava orçamento e reescrevia notas que já estavam certas.
        slugs = pendentes[:1]

    if not slugs:
        sair(t("cli.retry.nothing_pending"), 0)

    resultados = []
    falhou = False
    for s in slugs:
        if not em_json:
            print(t("cli.retry.reprocessing", slug=s))
        res = engine.reprocess_meeting(s)
        resultados.append({"slug": s, **res})
        if res.get("status") not in ("success", "partial"):
            falhou = True
        elif (res.get("result") or {}).get("transcription_provider") == "failed":
            falhou = True

    if em_json:
        print(json.dumps({"results": resultados}, ensure_ascii=False))
        sys.exit(2 if falhou else 0)

    for r in resultados:
        if r.get("status") in ("success", "partial"):
            res_data = r.get("result", {})
            problemas = res_data.get("problemas") or []
            if not problemas:
                print(t("cli.retry.success", slug=r["slug"]))
            else:
                print(t("cli.retry.partial", slug=r["slug"]))
                for p in problemas:
                    print(f"     · {p}")
            print(t("cli.retry.bronze", dir=res_data.get("bronze_dir")))
            print(t("cli.retry.silver", file=res_data.get("silver_file")))
            print(t("cli.retry.gold", file=res_data.get("gold_file")))
        else:
            print(t("cli.retry.error", slug=r["slug"], message=r.get("message")))

    # Código de saída honesto, como o `stop`: transcrição que falhou de novo
    # não é sucesso.
    if falhou:
        sys.exit(2)


def cmd_agenda(args):
    from castanha.agenda import collect_upcoming
    proximas = collect_upcoming(window_minutes=args.horas * 60)

    if args.json:
        print(json.dumps({"meetings": [m.to_dict() for m in proximas]}, ensure_ascii=False))
        return

    if not proximas:
        print(t("cli.agenda.none", hours=args.horas))
        return
    print(t("cli.agenda.upcoming", hours=args.horas))
    for m in proximas:
        hora = m.start.astimezone().strftime("%d/%m %H:%M")
        conta = f" · {m.account}" if m.account else ""
        pessoas = t("cli.agenda.attendees", count=len(m.attendees)) if m.attendees else ""
        chamada = f"\n      {m.conference_url}" if m.conference_url else ""
        print(f"  {hora}  {m.title}{conta}{pessoas}{chamada}")


def cmd_agenda_refresh(args):
    """Bate manualmente nas agendas (feeds iCal + contas Zinom) e atualiza o estado imediatamente."""
    from castanha.agenda import agenda_warning, collect_upcoming
    from castanha.config import load_config
    from castanha.state import StateManager

    cfg = load_config()
    horas = getattr(args, "horas", 12) or 12
    window_minutes = horas * 60

    mgr = StateManager()
    try:
        proximas = collect_upcoming(cfg, window_minutes=window_minutes, force=True)
        proximas_dicts = [m.to_dict() for m in proximas]
        mgr.write({
            "next_meeting": _proxima_com_hora(proximas_dicts),
            "upcoming_meetings": proximas_dicts,
            "agenda_error": agenda_warning(cfg),
        })
        if getattr(args, "json", False):
            print(json.dumps({
                "status": "ok",
                "count": len(proximas),
                "meetings": proximas_dicts,
            }, ensure_ascii=False))
        else:
            n = len(proximas)
            print(t("cli.agenda.refreshed", count=n, hours=horas))
            for m in proximas:
                hora = m.start.astimezone().strftime("%d/%m %H:%M")
                conta = f" · {m.account}" if m.account else ""
                pessoas = t("cli.agenda.attendees", count=len(m.attendees)) if m.attendees else ""
                chamada = f"\n      {m.conference_url}" if m.conference_url else ""
                print(f"  {hora}  {m.title}{conta}{pessoas}{chamada}")
    except Exception as e:
        mgr.write({"agenda_error": agenda_warning(cfg, e)})
        if getattr(args, "json", False):
            print(json.dumps({"status": "error", "error": str(e)}, ensure_ascii=False))
            sys.exit(1)
        else:
            print(t("cli.agenda.refresh_error", error=e), file=sys.stderr)
            sys.exit(1)


def _proxima_com_hora(eventos):
    """Evento de dia inteiro não vira 'a próxima reunião' (barra e aviso)."""
    return next((m for m in eventos if not m.get("all_day")), None)


def _refresh_agenda_state():
    """Refiltra a agenda que já está no estado, sem ir à rede.

    É o que dá resposta instantânea ao clique de "não mostrar" no painel: o
    daemon só refaz a busca a cada cinco minutos.
    """
    from castanha.hidden import is_hidden, load_hidden
    from castanha.state import StateManager

    mgr = StateManager()
    estado = mgr.read()
    escondidos = load_hidden()
    restantes = [m for m in (estado.get("upcoming_meetings") or [])
                 if not is_hidden(m.get("series_key") or m.get("uid"), escondidos)]
    mgr.write({
        "upcoming_meetings": restantes,
        "next_meeting": _proxima_com_hora(restantes),
    })


def cmd_agenda_hide(args):
    from castanha.hidden import hide

    chave = hide(args.uid, args.title)
    if not chave:
        print(t("cli.hidden.need_key"))
        sys.exit(1)
    _refresh_agenda_state()
    print(t("cli.hidden.hidden", title=args.title or chave))
    print(t("cli.hidden.hint", chave=chave))


def cmd_agenda_unhide(args):
    from castanha.hidden import unhide, unhide_all

    if args.all:
        print(t("cli.unhide.all", count=unhide_all()))
    elif args.uid:
        print(t("cli.unhide.back") if unhide(args.uid) else t("cli.unhide.not_hidden"))
    else:
        print(t("cli.unhide.need_key"))
        sys.exit(1)
    _refresh_agenda_state()


def cmd_agenda_hidden(args):
    from castanha.hidden import listar

    escondidos = listar()
    if args.json:
        print(json.dumps({"hidden": escondidos}, ensure_ascii=False))
        return
    if not escondidos:
        print(t("cli.hidden_list.none"))
        return
    print(t("cli.hidden_list.title"))
    for e in escondidos:
        print(f"  {e['title'] or t('cli.hidden_list.no_title')}\n     chave: {e['key']}")


def main():
    parser = argparse.ArgumentParser(
        prog="castanha",
        description=t("cli.help.description"),
    )
    subparsers = parser.add_subparsers(dest="command", help=t("cli.help.commands"))

    # Start
    p_start = subparsers.add_parser("start", help=t("cli.help.start"))
    p_start.add_argument("--mode", choices=["dual", "mic_only"], default=None, help=t("cli.help.mode"))
    p_start.add_argument("--mic-only", action="store_true", help=t("cli.help.mic_only"))
    p_start.add_argument("--title", type=str, default=None, help=t("cli.help.title"))
    p_start.add_argument("--meeting", "--append", type=str, default=None, help=t("cli.help.meeting"))
    p_start.add_argument("--event", type=str, default=None, help=t("cli.help.event"))
    p_start.set_defaults(func=cmd_start)

    # Stop
    p_stop = subparsers.add_parser("stop", help=t("cli.help.stop"))
    p_stop.set_defaults(func=cmd_stop)

    # Pause & Resume
    p_pause = subparsers.add_parser("pause", help=t("cli.help.pause"))
    p_pause.set_defaults(func=cmd_pause)
    p_resume = subparsers.add_parser("resume", help=t("cli.help.resume"))
    p_resume.set_defaults(func=cmd_resume)

    # Toggle (para atalho de teclado global)
    p_toggle = subparsers.add_parser("toggle", help=t("cli.help.toggle"))
    p_toggle.add_argument("--mode", choices=["dual", "mic_only"], default=None)
    p_toggle.add_argument("--mic-only", action="store_true")
    p_toggle.add_argument("--title", type=str, default=None)
    p_toggle.add_argument("--meeting", "--append", type=str, default=None)
    p_toggle.set_defaults(func=cmd_toggle)

    # Status
    p_status = subparsers.add_parser("status", help=t("cli.help.status"))
    p_status.add_argument("--json", action="store_true", help=t("cli.help.json"))
    p_status.set_defaults(func=cmd_status)

    # Daemon
    p_daemon = subparsers.add_parser("daemon", help=t("cli.help.daemon"))
    p_daemon.add_argument("--background", "-b", action="store_true", help=t("cli.help.daemon_background"))
    p_daemon.add_argument("--stop", action="store_true", help=t("cli.help.daemon_stop"))
    p_daemon.add_argument("--status", action="store_true", help=t("cli.help.daemon_status"))
    p_daemon.set_defaults(func=cmd_daemon)

    # Config
    p_config = subparsers.add_parser("config", help=t("cli.help.config"))
    p_config.add_argument("action", choices=["show", "path"], default="show", nargs="?")
    p_config.set_defaults(func=cmd_config)

    # Notes
    p_notes = subparsers.add_parser("notes", help=t("cli.help.notes"))
    p_notes.add_argument("slug", nargs="?", default=None, help=t("cli.help.notes_slug"))
    p_notes.add_argument("--open", action="store_true", help=t("cli.help.notes_open"))
    p_notes.add_argument("--json", action="store_true", help=t("cli.help.notes_json"))
    p_notes.add_argument("--limit", type=int, default=10, help=t("cli.help.notes_limit"))
    p_notes.set_defaults(func=cmd_notes)

    # Delete Recording (atalho direto)
    p_del = subparsers.add_parser("delete-recording", aliases=["del-rec", "delete-audio"], help=t("cli.help.delete_recording"))
    p_del.add_argument("slug", help=t("cli.help.slug_last"))
    p_del.add_argument("arquivo", nargs="?", default=None, help=t("cli.help.arquivo"))
    p_del.add_argument("--json", action="store_true", help=t("cli.help.json_short"))
    p_del.set_defaults(func=cmd_delete_recording)

    # Recordings (subcomando)
    p_recs = subparsers.add_parser("recordings", help=t("cli.help.recordings"))
    recs_sub = p_recs.add_subparsers(dest="recordings_cmd")
    p_recs_list = recs_sub.add_parser("list", help=t("cli.help.recordings_list"))
    p_recs_list.add_argument("slug", help=t("cli.help.slug"))
    p_recs_list.add_argument("--json", action="store_true")
    p_recs_list.set_defaults(func=cmd_recordings_list)
    p_recs_del = recs_sub.add_parser("delete", help=t("cli.help.recordings_delete"))
    p_recs_del.add_argument("slug", help=t("cli.help.slug"))
    p_recs_del.add_argument("arquivo", nargs="?", default=None)
    p_recs_del.add_argument("--json", action="store_true")
    p_recs_del.set_defaults(func=cmd_delete_recording)

    # Sync
    p_sync = subparsers.add_parser("sync", help=t("cli.help.sync"))
    p_sync.add_argument("slug", nargs="?", default=None, help=t("cli.help.sync_slug"))
    p_sync.add_argument("--all", action="store_true", help=t("cli.help.sync_all"))
    p_sync.add_argument("--limit", type=int, default=None, help=t("cli.help.sync_limit"))
    p_sync.add_argument("--json", action="store_true", help=t("cli.help.json_short"))
    p_sync.set_defaults(func=cmd_sync)

    # Retry / Reprocess
    p_retry = subparsers.add_parser(
        "retry",
        aliases=["reprocess", "retry-upload", "retry-transcription"],
        help=t("cli.help.retry"),
    )
    p_retry.add_argument("slug", nargs="?", default=None, help=t("cli.help.retry_slug"))
    p_retry.add_argument("--all", action="store_true", help=t("cli.help.retry_all"))
    p_retry.add_argument("--limit", type=int, default=20, help=t("cli.help.retry_limit"))
    p_retry.add_argument("--json", action="store_true", help=t("cli.help.json_short"))
    p_retry.set_defaults(func=cmd_retry)

    # Agenda
    p_agenda = subparsers.add_parser("agenda", help=t("cli.help.agenda"))
    p_agenda.add_argument("--json", action="store_true", help=t("cli.help.json_short"))
    p_agenda.add_argument("--horas", type=int, default=12, help=t("cli.help.horas"))
    p_agenda.set_defaults(func=cmd_agenda)

    ag_sub = p_agenda.add_subparsers(dest="agenda_cmd")

    p_refresh = ag_sub.add_parser("refresh", aliases=["sync", "update"], help=t("cli.help.agenda_refresh"))
    p_refresh.add_argument("--json", action="store_true", help=t("cli.help.json_short"))
    p_refresh.add_argument("--horas", type=int, default=12, help=t("cli.help.horas"))
    p_refresh.set_defaults(func=cmd_agenda_refresh)

    p_hide = ag_sub.add_parser("hide", help=t("cli.help.agenda_hide"))
    p_hide.add_argument("uid", help=t("cli.help.hide_uid"))
    p_hide.add_argument("--title", default="", help=t("cli.help.hide_title"))
    p_hide.set_defaults(func=cmd_agenda_hide)

    p_unhide = ag_sub.add_parser("unhide", help=t("cli.help.agenda_unhide"))
    p_unhide.add_argument("uid", nargs="?", default=None, help=t("cli.help.unhide_uid"))
    p_unhide.add_argument("--all", action="store_true", help=t("cli.help.unhide_all"))
    p_unhide.set_defaults(func=cmd_agenda_unhide)

    p_hidden = ag_sub.add_parser("hidden", help=t("cli.help.agenda_hidden"))
    p_hidden.add_argument("--json", action="store_true")
    p_hidden.set_defaults(func=cmd_agenda_hidden)

    # Atalho de nível superior para atualizar agenda imediatamente
    p_top_refresh = subparsers.add_parser("refresh-agenda", help=t("cli.help.refresh_agenda"))
    p_top_refresh.add_argument("--json", action="store_true", help=t("cli.help.json_short"))
    p_top_refresh.add_argument("--horas", type=int, default=12, help=t("cli.help.horas"))
    p_top_refresh.set_defaults(func=cmd_agenda_refresh)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    args.func(args)

if __name__ == "__main__":
    main()
