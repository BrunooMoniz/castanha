#!/usr/bin/env python3
"""CLI do Castanha: Gravador e assistente de reuniões para Omarchy/Linux."""

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

# Adiciona o diretório do pacote ao sys.path para execução direta
project_root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(project_root))

from castanha.config import get_config_file, load_config, save_config
from castanha.engine import CastanhaEngine
from castanha.state import StateManager
from castanha.storage import MeetingStorage

def _evento_da_agenda(uid):
    """O evento pelo uid, na agenda que o daemon já deixou no estado."""
    if not uid:
        return None
    estado = StateManager().read()
    candidatos = list(estado.get("upcoming_meetings") or [])
    if estado.get("next_meeting"):
        candidatos.append(estado["next_meeting"])
    for m in candidatos:
        if isinstance(m, dict) and str(m.get("uid") or "") == str(uid):
            return m
    return None


def cmd_start(args):
    engine = CastanhaEngine()
    mode = "mic_only" if args.mic_only else (args.mode or "dual")
    meeting_slug = getattr(args, "meeting", None)
    evento = _evento_da_agenda(getattr(args, "event", None))
    if getattr(args, "event", None) and evento is None:
        print(f"[Castanha] Evento {args.event} não está na agenda carregada; gravando pelo título.", file=sys.stderr)
    res = engine.start_recording(mode=mode, title=args.title, meeting_event=evento, meeting_slug=meeting_slug)
    if res.get("status") == "recording":
        print(f"🌰 Gravação iniciada com sucesso! [PID: {res.get('pid')}]")
        print(f"📌 Título: {res.get('title')}")
        print(f"🎙️ Modo: {mode}")
        if meeting_slug:
            print(f"🔗 Vinculada à reunião: {meeting_slug}")
        if res.get("mic_muted"):
            print("🔇 ATENÇÃO: o microfone está MUDO no sistema/teclado. Desmute antes de falar.")
    else:
        print(f"❌ Erro: {res.get('message')}")
        sys.exit(1)

def cmd_stop(args):
    engine = CastanhaEngine()
    print("⏳ Finalizando reunião e processando notas...")
    res = engine.stop_recording()
    if res.get("status") not in ("success", "partial"):
        print(f"❌ Erro: {res.get('message')}")
        sys.exit(1)

    result = res.get("result", {})
    problemas = result.get("problemas") or []

    if not problemas:
        print("✅ Reunião finalizada com sucesso!")
    else:
        print("⚠️  Reunião finalizada COM PROBLEMA:")
        for p in problemas:
            print(f"   · {p}")

    print(f"📁 Bronze: {result.get('bronze_dir')}")
    print(f"📝 Silver (Notas): {result.get('silver_file')}")
    print(f"🧠 Gold (Fatos): {result.get('gold_file')}")

    # Código de saída honesto: quem chamar isto de script precisa saber.
    if problemas:
        sys.exit(2)

def cmd_pause(args):
    engine = CastanhaEngine()
    res = engine.pause_recording()
    if res.get("status") == "paused":
        print("⏸️ Gravação pausada.")
    else:
        print(f"❌ Erro: {res.get('message')}")

def cmd_resume(args):
    engine = CastanhaEngine()
    res = engine.resume_recording()
    if res.get("status") == "recording":
        print("▶️ Gravação retomada.")
    else:
        print(f"❌ Erro: {res.get('message')}")

def cmd_toggle(args):
    engine = CastanhaEngine()
    state = engine.get_status()
    if state.get("status") in ["recording", "paused"]:
        cmd_stop(args)
    else:
        cmd_start(args)

def cmd_status(args):
    state_mgr = StateManager()
    state = MeetingStorage().status_projection(state_mgr.read())
    if args.json:
        print(json.dumps(state, indent=2, ensure_ascii=False))
        return

    status = state.get("status", "idle")
    icons = {"idle": "⚪ Ocioso", "recording": "🔴 Gravando", "paused": "⏸️ Pausado", "processing": "⏳ Processando"}
    print(f"Status: {icons.get(status, status)}")
    if status in ["recording", "paused"]:
        elapsed = state.get("elapsed_seconds", 0)
        mins, secs = divmod(elapsed, 60)
        hours, mins = divmod(mins, 60)
        timer = f"{hours:02d}:{mins:02d}:{secs:02d}" if hours else f"{mins:02d}:{secs:02d}"
        print(f"Tempo decorrido: {timer}")
        print(f"Modo: {state.get('mode')}")
        if state.get("current_meeting"):
            print(f"Reunião: {state['current_meeting'].get('title')}")
    
    if state.get("next_meeting"):
        next_m = state["next_meeting"]
        print(f"Próxima reunião: {next_m.get('title')} ({next_m.get('start')})")

def cmd_daemon(args):
    from castanha.daemon import run_daemon, running_daemon_pid

    if args.stop:
        import signal as _sig
        pid = running_daemon_pid()
        if pid is None:
            print("Nenhum daemon rodando.")
            return
        os.kill(pid, _sig.SIGTERM)
        print(f"🌰 Daemon encerrado (PID {pid}).")
        return

    if args.status:
        pid = running_daemon_pid()
        print(f"🌰 Daemon rodando (PID {pid})." if pid else "Nenhum daemon rodando.")
        return

    ja = running_daemon_pid()
    if ja is not None:
        print(f"🌰 Já existe um daemon rodando (PID {ja}). Nada a fazer.")
        return

    if args.background:
        subprocess.Popen([sys.executable, "-m", "castanha.daemon"], cwd=str(project_root), start_new_session=True)
        print("🌰 Daemon do Castanha iniciado em segundo plano.")
    else:
        print("🌰 Iniciando daemon do Castanha em primeiro plano (Ctrl+C para encerrar)...")
        run_daemon()

def cmd_config(args):
    if args.action == "show":
        print(json.dumps(load_config(), indent=2, ensure_ascii=False))
    elif args.action == "path":
        print(get_config_file())

def cmd_notes(args):
    storage = MeetingStorage()
    slug = getattr(args, "slug", None)
    if slug:
        meeting = storage.get_meeting(slug)
        if not meeting:
            print(f"Reunião '{slug}' não encontrada.")
            sys.exit(1)
        if getattr(args, "json", False):
            print(json.dumps(meeting, indent=2, ensure_ascii=False))
            return
        print(f"📌 {meeting['title']}")
        print(f"   Data: {meeting['when']} · Duração: {meeting['duration_seconds']}s · Modo: {meeting['mode']}")
        print(f"   Status do áudio: {meeting['audio_status']}")
        if meeting.get("attendees"):
            print("   Participantes:")
            for a in meeting["attendees"]:
                nome = a.get("name") or a.get("email") or "Sem nome"
                email = f" <{a['email']}>" if a.get("email") and a.get("name") else ""
                print(f"     · {nome}{email}")
        if meeting.get("recordings"):
            print("   Gravações de áudio:")
            for r in meeting["recordings"]:
                print(f"     · {r['filename']} ({r['size_human']}) -> {r['path']}")
        else:
            print("   Gravações de áudio: (nenhuma no disco / apagada)")
        if meeting.get("summary_preview"):
            print(f"   Resumo Executivo:\n     {meeting['summary_preview']}")
        print(f"   Notas Silver: {meeting['silver_path']}")
        if meeting.get("has_transcript"):
            print(f"   Transcrição: {meeting['transcript_path']}")
        if meeting.get("gold_path"):
            print(f"   Fatos Gold: {meeting['gold_path']}")
        return

    notes = storage.list_recent_meetings(limit=args.limit)

    if args.json:
        # É por aqui que o painel do Omarchy lista as últimas reuniões.
        print(json.dumps({"notes": notes, "silver_dir": str(storage.silver_dir)},
                         ensure_ascii=False))
        return

    if not notes:
        print("Nenhuma nota de reunião gravada ainda.")
        return
    print("Últimas reuniões registradas:")
    for idx, n in enumerate(notes, 1):
        recs = f" ({n.get('recordings_count', 0)} gravação/ões)" if n.get('recordings_count') else ""
        print(f" {idx}. {n['title']} ({n['when']}){recs} -> {n['silver_path']}")
    if args.open:
        subprocess.Popen(["xdg-open", str(storage.silver_dir)])


def cmd_delete_recording(args):
    engine = CastanhaEngine()
    slug = args.slug
    if slug in ("last", "latest"):
        recentes = engine.storage.list_recent_meetings(limit=1)
        if not recentes:
            print("Nenhuma reunião encontrada.")
            sys.exit(1)
        slug = recentes[0]["slug"]

    res = engine.delete_recording(slug, getattr(args, "arquivo", None))
    if getattr(args, "json", False):
        print(json.dumps(res, ensure_ascii=False))
        if res.get("status") != "ok":
            sys.exit(1)
        return

    if res.get("status") == "ok":
        print(f"🗑️ Gravação '{res.get('deleted_file')}' apagada com sucesso da reunião '{slug}'.")
        rem = res.get("remaining_count", 0)
        if rem > 0:
            print(f"   Ainda restam {rem} gravação(ões) nesta reunião.")
        else:
            print("   As notas em Silver, transcrição e dados no Zinom foram preservados.")
    else:
        print(f"❌ Erro: {res.get('message')}")
        sys.exit(1)


def cmd_recordings_list(args):
    storage = MeetingStorage()
    recs = storage.list_meeting_recordings(args.slug)
    if getattr(args, "json", False):
        print(json.dumps({"recordings": recs}, ensure_ascii=False))
        return
    if not recs:
        print(f"Nenhuma gravação de áudio encontrada para '{args.slug}'.")
        return
    print(f"Gravações da reunião '{args.slug}':")
    for idx, r in enumerate(recs, 1):
        print(f" {idx}. {r['filename']} ({r['size_human']}) -> {r['path']}")



def cmd_sync(args):
    from castanha.sync import sync_meeting, sync_pending

    if args.all:
        resultados = sync_pending(limit=args.limit)
        if not resultados:
            print("Nenhuma entrega pendente nesta execução.")
            return
    elif args.slug:
        resultados = [sync_meeting(args.slug)]
    else:
        recentes = MeetingStorage().list_recent_meetings(limit=1)
        if not recentes:
            print("Nenhuma reunião gravada ainda.")
            return
        resultados = [sync_meeting(recentes[0]["slug"])]

    if args.json:
        print(json.dumps({"results": resultados}, ensure_ascii=False))
        return

    falhou = False
    for r in resultados:
        if r.get("status") == "ok":
            fatos = r.get("facts_ingested", 0)
            print(f"✅ {r['slug']}: salvo no Zinom" + (f", com {fatos} fato(s)" if fatos else ""))
        elif r.get("status") == "pending":
            falhou = True
            print(f"⏳ {r['slug']}: pendente ({r.get('reason') or 'aguardando nova tentativa'})")
        elif r.get("status") == "tombstoned":
            print(f"⏭️  {r['slug']}: exclusão no Zinom preservada")
        elif r.get("status") == "skipped":
            print(f"⏭️  {r['slug']}: não enviado ({r.get('reason')})")
        else:
            falhou = True
            print(f"❌ {r['slug']}: não salvou")
            for e in r.get("errors", []):
                print(f"     {e}")
    if falhou:
        sys.exit(2)


def cmd_retry(args):
    """Tenta reenviar áudio para transcrição e rodar toda a esteira (Silver, Gold, Zinom)."""
    engine = CastanhaEngine()
    storage = engine.storage
    em_json = getattr(args, "json", False)

    def sair(mensagem, codigo, resultados=None):
        if em_json:
            print(json.dumps({"results": resultados or [], "message": mensagem}, ensure_ascii=False))
        elif codigo == 0:
            print(mensagem)
        else:
            print(mensagem, file=sys.stderr)
        sys.exit(codigo)

    recentes = storage.list_recent_meetings(limit=args.limit)
    pendentes = [m["slug"] for m in recentes if m.get("can_retry")]

    if args.all:
        slugs = pendentes
    elif args.slug in ("last", "latest"):
        if not recentes:
            sair("Nenhuma reunião encontrada.", 1)
        slugs = [recentes[0]["slug"]]
    elif args.slug:
        slugs = [args.slug]
    else:
        # Sem argumento é "a última pendente". Nunca a última reunião boa: isso
        # gastava orçamento e reescrevia notas que já estavam certas.
        slugs = pendentes[:1]

    if not slugs:
        sair("Nada pendente: nenhuma reunião com áudio aguardando transcrição.", 0)

    resultados = []
    falhou = False
    for s in slugs:
        if not em_json:
            print(f"⏳ Reprocessando reunião '{s}'...")
        res = engine.reprocess_meeting(s)
        resultados.append({"slug": s, **res})
        if res.get("status") not in ("success", "partial"):
            falhou = True
        elif (res.get("result") or {}).get("transcription_provider") == "failed":
            falhou = True

    if em_json:
        print(json.dumps({"results": resultados}, ensure_ascii=False))
        sys.exit(2 if falhou else 0)

    for r in resultados:
        if r.get("status") in ("success", "partial"):
            res_data = r.get("result", {})
            problemas = res_data.get("problemas") or []
            if not problemas:
                print(f"✅ {r['slug']}: áudio transcrito e notas geradas com sucesso!")
            else:
                print(f"⚠️  {r['slug']}: reprocessado com observações:")
                for p in problemas:
                    print(f"     · {p}")
            print(f"   📁 Bronze: {res_data.get('bronze_dir')}")
            print(f"   📝 Silver: {res_data.get('silver_file')}")
            print(f"   🧠 Gold:   {res_data.get('gold_file')}")
        else:
            print(f"❌ {r['slug']}: erro ao reprocessar ({r.get('message')})")

    # Código de saída honesto, como o `stop`: transcrição que falhou de novo
    # não é sucesso.
    if falhou:
        sys.exit(2)


def cmd_agenda(args):
    from castanha.agenda import collect_upcoming
    proximas = collect_upcoming(window_minutes=args.horas * 60)

    if args.json:
        print(json.dumps({"meetings": [m.to_dict() for m in proximas]}, ensure_ascii=False))
        return

    if not proximas:
        print(f"Nenhuma reunião nas próximas {args.horas}h.")
        return
    print(f"Próximas reuniões ({args.horas}h):")
    for m in proximas:
        hora = m.start.astimezone().strftime("%d/%m %H:%M")
        conta = f" · {m.account}" if m.account else ""
        pessoas = f" · {len(m.attendees)} participantes" if m.attendees else ""
        chamada = f"\n      {m.conference_url}" if m.conference_url else ""
        print(f"  {hora}  {m.title}{conta}{pessoas}{chamada}")


def cmd_agenda_refresh(args):
    """Bate manualmente nas agendas (feeds iCal + contas Zinom) e atualiza o estado imediatamente."""
    from castanha.agenda import agenda_warning, collect_upcoming
    from castanha.config import load_config
    from castanha.state import StateManager

    cfg = load_config()
    horas = getattr(args, "horas", 12) or 12
    window_minutes = horas * 60

    mgr = StateManager()
    try:
        proximas = collect_upcoming(cfg, window_minutes=window_minutes, force=True)
        proximas_dicts = [m.to_dict() for m in proximas]
        mgr.write({
            "next_meeting": _proxima_com_hora(proximas_dicts),
            "upcoming_meetings": proximas_dicts,
            "agenda_error": agenda_warning(cfg),
        })
        if getattr(args, "json", False):
            print(json.dumps({
                "status": "ok",
                "count": len(proximas),
                "meetings": proximas_dicts,
            }, ensure_ascii=False))
        else:
            n = len(proximas)
            print(f"Agenda atualizada: {n} reunião(ões) encontrada(s) nas próximas {horas}h.")
            for m in proximas:
                hora = m.start.astimezone().strftime("%d/%m %H:%M")
                conta = f" · {m.account}" if m.account else ""
                pessoas = f" · {len(m.attendees)} participantes" if m.attendees else ""
                chamada = f"\n      {m.conference_url}" if m.conference_url else ""
                print(f"  {hora}  {m.title}{conta}{pessoas}{chamada}")
    except Exception as e:
        mgr.write({"agenda_error": agenda_warning(cfg, e)})
        if getattr(args, "json", False):
            print(json.dumps({"status": "error", "error": str(e)}, ensure_ascii=False))
            sys.exit(1)
        else:
            print(f"Erro ao atualizar agenda: {e}", file=sys.stderr)
            sys.exit(1)


def _proxima_com_hora(eventos):
    """Evento de dia inteiro não vira 'a próxima reunião' (barra e aviso)."""
    return next((m for m in eventos if not m.get("all_day")), None)


def _refresh_agenda_state():
    """Refiltra a agenda que já está no estado, sem ir à rede.

    É o que dá resposta instantânea ao clique de "não mostrar" no painel: o
    daemon só refaz a busca a cada cinco minutos.
    """
    from castanha.hidden import is_hidden, load_hidden
    from castanha.state import StateManager

    mgr = StateManager()
    estado = mgr.read()
    escondidos = load_hidden()
    restantes = [m for m in (estado.get("upcoming_meetings") or [])
                 if not is_hidden(m.get("series_key") or m.get("uid"), escondidos)]
    mgr.write({
        "upcoming_meetings": restantes,
        "next_meeting": _proxima_com_hora(restantes),
    })


def cmd_agenda_hide(args):
    from castanha.hidden import hide

    chave = hide(args.uid, args.title)
    if not chave:
        print("❌ Precisa de um uid ou series_key.")
        sys.exit(1)
    _refresh_agenda_state()
    print(f"🙈 Escondido: {args.title or chave}")
    print("   Vale para a série inteira. Para voltar: castanha agenda unhide " + chave)


def cmd_agenda_unhide(args):
    from castanha.hidden import unhide, unhide_all

    if args.all:
        print(f"👁️  {unhide_all()} evento(s) voltaram a aparecer.")
    elif args.uid:
        print("👁️  De volta à agenda." if unhide(args.uid) else "Esse evento não estava escondido.")
    else:
        print("❌ Informe a chave ou use --all.")
        sys.exit(1)
    _refresh_agenda_state()


def cmd_agenda_hidden(args):
    from castanha.hidden import listar

    escondidos = listar()
    if args.json:
        print(json.dumps({"hidden": escondidos}, ensure_ascii=False))
        return
    if not escondidos:
        print("Nada escondido.")
        return
    print("Eventos que você mandou não mostrar:")
    for e in escondidos:
        print(f"  {e['title'] or '(sem título)'}\n     chave: {e['key']}")


def main():
    parser = argparse.ArgumentParser(
        prog="castanha",
        description="Castanha: Gravador e assistente de reuniões para Omarchy/Linux",
    )
    subparsers = parser.add_subparsers(dest="command", help="Comandos disponíveis")

    # Start
    p_start = subparsers.add_parser("start", help="Inicia a gravação de uma reunião")
    p_start.add_argument("--mode", choices=["dual", "mic_only"], default=None, help="Modo de gravação")
    p_start.add_argument("--mic-only", action="store_true", help="Atalho para modo apenas microfone (presencial)")
    p_start.add_argument("--title", type=str, default=None, help="Título da reunião")
    p_start.add_argument("--meeting", "--append", type=str, default=None, help="Slug de reunião existente para adicionar a gravação")
    p_start.add_argument("--event", type=str, default=None, help="uid de um evento da agenda: a gravação leva título, participantes e link dele")
    p_start.set_defaults(func=cmd_start)

    # Stop
    p_stop = subparsers.add_parser("stop", help="Finaliza a gravação e processa as notas")
    p_stop.set_defaults(func=cmd_stop)

    # Pause & Resume
    p_pause = subparsers.add_parser("pause", help="Pausa a gravação")
    p_pause.set_defaults(func=cmd_pause)
    p_resume = subparsers.add_parser("resume", help="Retoma a gravação")
    p_resume.set_defaults(func=cmd_resume)

    # Toggle (para atalho de teclado global)
    p_toggle = subparsers.add_parser("toggle", help="Inicia ou para a gravação (ideal para atalho de teclado)")
    p_toggle.add_argument("--mode", choices=["dual", "mic_only"], default=None)
    p_toggle.add_argument("--mic-only", action="store_true")
    p_toggle.add_argument("--title", type=str, default=None)
    p_toggle.add_argument("--meeting", "--append", type=str, default=None)
    p_toggle.set_defaults(func=cmd_toggle)

    # Status
    p_status = subparsers.add_parser("status", help="Exibe o status atual do gravador")
    p_status.add_argument("--json", action="store_true", help="Saída em formato JSON")
    p_status.set_defaults(func=cmd_status)

    # Daemon
    p_daemon = subparsers.add_parser("daemon", help="Gerencia o daemon em background")
    p_daemon.add_argument("--background", "-b", action="store_true", help="Roda em segundo plano desanexado")
    p_daemon.add_argument("--stop", action="store_true", help="Encerra o daemon que estiver rodando")
    p_daemon.add_argument("--status", action="store_true", help="Diz se há daemon rodando, e qual PID")
    p_daemon.set_defaults(func=cmd_daemon)

    # Config
    p_config = subparsers.add_parser("config", help="Gerencia configurações")
    p_config.add_argument("action", choices=["show", "path"], default="show", nargs="?")
    p_config.set_defaults(func=cmd_config)

    # Notes
    p_notes = subparsers.add_parser("notes", help="Lista as últimas reuniões ou exibe detalhes de uma reunião")
    p_notes.add_argument("slug", nargs="?", default=None, help="Slug da reunião para ver detalhes completos")
    p_notes.add_argument("--open", action="store_true", help="Abre a pasta de notas no gerenciador de arquivos")
    p_notes.add_argument("--json", action="store_true", help="Saída em JSON (usada pelo plugin do Omarchy)")
    p_notes.add_argument("--limit", type=int, default=10, help="Quantas reuniões listar")
    p_notes.set_defaults(func=cmd_notes)

    # Delete Recording (atalho direto)
    p_del = subparsers.add_parser("delete-recording", aliases=["del-rec", "delete-audio"], help="Apaga uma gravação de áudio de uma reunião sem apagar as notas")
    p_del.add_argument("slug", help="Slug da reunião (ou 'last' para a última)")
    p_del.add_argument("arquivo", nargs="?", default=None, help="Nome do arquivo de áudio específico (ex: audio.ogg)")
    p_del.add_argument("--json", action="store_true", help="Saída em JSON")
    p_del.set_defaults(func=cmd_delete_recording)

    # Recordings (subcomando)
    p_recs = subparsers.add_parser("recordings", help="Gerencia gravações de áudio das reuniões")
    recs_sub = p_recs.add_subparsers(dest="recordings_cmd")
    p_recs_list = recs_sub.add_parser("list", help="Lista gravações de áudio de uma reunião")
    p_recs_list.add_argument("slug", help="Slug da reunião")
    p_recs_list.add_argument("--json", action="store_true")
    p_recs_list.set_defaults(func=cmd_recordings_list)
    p_recs_del = recs_sub.add_parser("delete", help="Apaga uma gravação de áudio de uma reunião")
    p_recs_del.add_argument("slug", help="Slug da reunião")
    p_recs_del.add_argument("arquivo", nargs="?", default=None)
    p_recs_del.add_argument("--json", action="store_true")
    p_recs_del.set_defaults(func=cmd_delete_recording)

    # Sync
    p_sync = subparsers.add_parser("sync", help="Reenvia uma reunião ao Zinom (a última, por padrão)")
    p_sync.add_argument("slug", nargs="?", default=None, help="Slug da reunião; vazio = a última")
    p_sync.add_argument("--all", action="store_true", help="Reenvia tudo que ficou pendente")
    p_sync.add_argument("--limit", type=int, default=None, help="Máximo de pendências por execução; padrão: todas")
    p_sync.add_argument("--json", action="store_true", help="Saída em JSON")
    p_sync.set_defaults(func=cmd_sync)

    # Retry / Reprocess
    p_retry = subparsers.add_parser(
        "retry",
        aliases=["reprocess", "retry-upload", "retry-transcription"],
        help="Tenta reenviar áudio para transcrição e processar notas/fatos/Zinom",
    )
    p_retry.add_argument("slug", nargs="?", default=None, help="Slug da reunião (ou 'last' para a última reunião); sem slug, a última pendente")
    p_retry.add_argument("--all", action="store_true", help="Reprocessa todas as reuniões pendentes de transcrição")
    p_retry.add_argument("--limit", type=int, default=20, help="Quantas reuniões olhar com --all")
    p_retry.add_argument("--json", action="store_true", help="Saída em JSON")
    p_retry.set_defaults(func=cmd_retry)

    # Agenda
    p_agenda = subparsers.add_parser("agenda", help="Próximas reuniões das contas Google conectadas no Zinom")
    p_agenda.add_argument("--json", action="store_true", help="Saída em JSON")
    p_agenda.add_argument("--horas", type=int, default=12, help="Janela em horas")
    p_agenda.set_defaults(func=cmd_agenda)

    ag_sub = p_agenda.add_subparsers(dest="agenda_cmd")

    p_refresh = ag_sub.add_parser("refresh", aliases=["sync", "update"], help="Bate nas agendas agora e atualiza o estado")
    p_refresh.add_argument("--json", action="store_true", help="Saída em JSON")
    p_refresh.add_argument("--horas", type=int, default=12, help="Janela em horas")
    p_refresh.set_defaults(func=cmd_agenda_refresh)

    p_hide = ag_sub.add_parser("hide", help="Para de mostrar um evento (a série inteira)")
    p_hide.add_argument("uid", help="uid ou series_key do evento (o painel manda o series_key)")
    p_hide.add_argument("--title", default="", help="Título, só para você reconhecer na lista")
    p_hide.set_defaults(func=cmd_agenda_hide)

    p_unhide = ag_sub.add_parser("unhide", help="Volta a mostrar um evento escondido")
    p_unhide.add_argument("uid", nargs="?", default=None, help="Chave a reexibir; vazio com --all limpa tudo")
    p_unhide.add_argument("--all", action="store_true", help="Volta a mostrar todos")
    p_unhide.set_defaults(func=cmd_agenda_unhide)

    p_hidden = ag_sub.add_parser("hidden", help="Lista o que você mandou não mostrar")
    p_hidden.add_argument("--json", action="store_true")
    p_hidden.set_defaults(func=cmd_agenda_hidden)

    # Atalho de nível superior para atualizar agenda imediatamente
    p_top_refresh = subparsers.add_parser("refresh-agenda", help="Atualiza a agenda imediatamente nas contas e feeds")
    p_top_refresh.add_argument("--json", action="store_true", help="Saída em JSON")
    p_top_refresh.add_argument("--horas", type=int, default=12, help="Janela em horas")
    p_top_refresh.set_defaults(func=cmd_agenda_refresh)

    args = parser.parse_args()
    if not args.command:
        parser.print_help()
        sys.exit(0)

    args.func(args)

if __name__ == "__main__":
    main()
