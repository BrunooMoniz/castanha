{
  "manifest_version": 3,
  "name": "Castanha: quem fala no Meet e no Teams",
  "version": "0.4.0",
  "description": "Entrega ao Castanha, na própria máquina, quem está falando em cada momento de uma chamada do Google Meet ou do Microsoft Teams.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://meet.google.com/*", "https://teams.microsoft.com/*", "https://teams.live.com/*", "https://teams.cloud.microsoft/*"], "js": ["bridge.js"], "run_at": "document_start"}
  ]
}
