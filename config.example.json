{
  "storage": {
    "base_dir": "~/Notes/Meetings",
    "bronze_dir": "~/Notes/Meetings/bronze",
    "silver_dir": "~/Notes/Meetings/silver",
    "gold_dir": "~/Notes/Meetings/gold"
  },
  "audio": {
    "default_mode": "dual",
    "bitrate": "64k",
    "sample_rate": 48000,
    "format": "ogg"
  },
  "calendar": {
    "enabled": true,
    "poll_interval_sec": 60,
    "notify_minutes_before": 2,
    "auto_record": false,
    "feeds": [
      {
        "name": "Google Calendar Privado",
        "url": "https://calendar.google.com/calendar/ical/SEU_EMAIL/private-CHAVE/basic.ics"
      }
    ]
  },
  "transcription": {
    "provider": "vps_ssh",
    "groq_api_key": "gsk_...",
    "groq_model": "whisper-large-v3-turbo",
    "deepgram_api_key": "",
    "deepgram_model": "nova-2",
    "vps_endpoint": "",
    "vps_auth_token": "",
    "provider_revision": 0,
    "fallback_from": null,
    "groq_fallback_mode": "manual",
    "vps_ssh_host": "zinom-vps-2",
    "vps_model": "large-v3",
    "vps_compute_type": "int8",
    "vps_cpu_threads": 8,
    "vps_multilingual": true,
    "vps_worker_contract": "faster-whisper-json-v2",
    "vps_condition_on_previous_text": false,
    "vps_chunk_length": 30,
    "vps_segmentation_strategy": "whisper-vad-v1"
  },
  "llm": {
    "provider": "hermes_ssh",
    "hermes_ssh_host": "zinom-vps-2",
    "hermes_models": [
      {"provider": "anthropic", "model": "claude-opus-5"},
      {"provider": "openai-codex", "model": "gpt-5.5"}
    ],
    "hermes_reasoning": "medium",
    "hermes_timeout_sec": 900,
    "fallback_provider": "groq",
    "api_key": "gsk_...",
    "model": "openai/gpt-oss-120b"
  },
  "zinom": {
    "enabled": false,
    "endpoint": "https://zinom.ai/mcp",
    "token": ""
  }
}
