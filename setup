#!/usr/bin/env bash
# omarchy plugin add only clones files, so this is the rest of the install.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bin_dir="$HOME/.local/bin"
config_dir="$HOME/.config/castanha"

castanha_lang() {
    case "${LC_ALL:-${LANG:-}}" in
        [pP][tT]*) echo "pt" ;;
        *) echo "en" ;;
    esac
}

t() {
    if [ "$(castanha_lang)" = "pt" ]; then
        case "$1" in
            welcome) echo "🌰 Configurando Castanha para Omarchy/Linux..." ;;
            dep_missing) echo "⚠️  Aviso: dependência obrigatória '$2' não foi encontrada no PATH." ;;
            cli_installed) echo "  ✔ CLI instalado em $2" ;;
            config_created) echo "  ✔ Arquivo de configuração criado em $2" ;;
            done) echo "🎉 Castanha configurado com sucesso!" ;;
            bar_hint) echo "Para colocar o widget na barra:" ;;
        esac
    else
        case "$1" in
            welcome) echo "🌰 Setting up Castanha for Omarchy/Linux..." ;;
            dep_missing) echo "⚠️  Warning: required dependency '$2' was not found in PATH." ;;
            cli_installed) echo "  ✔ CLI installed at $2" ;;
            config_created) echo "  ✔ Config file created at $2" ;;
            done) echo "🎉 Castanha set up successfully!" ;;
            bar_hint) echo "To place the widget on the bar:" ;;
        esac
    fi
}

t welcome

# Verifica dependências obrigatórias
for dep in ffmpeg ffprobe pactl python3; do
    if ! command -v "$dep" >/dev/null 2>&1; then
        t dep_missing "$dep"
    fi
done

mkdir -p "$bin_dir" "$HOME/Notes/Meetings/bronze" "$HOME/Notes/Meetings/silver" "$HOME/Notes/Meetings/gold"

# O diretório de configuração guarda credenciais (Groq, Deepgram, VPS, Zinom),
# então nasce e é reafirmado como 0700: sob umask 022 o mkdir daria 0755 e
# qualquer outro usuário local poderia listar e ler o config.json.
mkdir -p -m 700 "$config_dir"
chmod 700 "$config_dir"

# 1. Symlink CLI
ln -sf "$root/bin/castanha" "$bin_dir/castanha"
chmod +x "$bin_dir/castanha"
chmod +x "$root/bin/castanha"
t cli_installed "$bin_dir/castanha"

# 2. Configuração padrão se não existir
# -e e não -f: um symlink plantado em config.json redirecionaria a cópia (e as
# credenciais que o usuário vai preencher) para fora do diretório dele.
if [ ! -e "$config_dir/config.json" ]; then
    # Cria vazio com 0600 ANTES de escrever: a cópia direta publicaria o
    # arquivo com o modo do umask por uma janela em que ele já tem conteúdo.
    (umask 077 && : > "$config_dir/config.json")
    chmod 600 "$config_dir/config.json"
    cat "$root/config.example.json" > "$config_dir/config.json"
    t config_created "$config_dir/config.json"
elif [ -f "$config_dir/config.json" ] && [ ! -L "$config_dir/config.json" ]; then
    # Instalação antiga pode ter deixado 0644 com chave dentro; fecha agora.
    chmod 600 "$config_dir/config.json"
fi

echo ""
t done
t bar_hint
echo "  omarchy bar put io.github.brunoomoniz.castanha"
echo ""
